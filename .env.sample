# Postgres (local dev container, see compose.yml)
POSTGRES_DB=zeitzeit
POSTGRES_USER=zeitzeit
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Database URL (read by sqlx-cli and by the API)
DATABASE_URL=postgres://zeitzeit:password@host:5432/zeitzeit

# Must be a literal IP:port (without hostnames). Use [::1]:8080 for IPv6.
BIND_ADDR=127.0.0.1:8080
# Host port mapped to the API container's 8080 (compose only; native runs use BIND_ADDR)
API_PORT=8080
# Lifetime of a web session token. API tokens never expire by default.
SESSION_TTL_HOURS=720
# Request timeout in seconds.
REQUEST_TIMEOUT_SECS=15
# Largest request body in bytes (must be > 0).
MAX_BODY_BYTES=65536
# Browser origins allowed through CORS. Empty until a web client exists.
CORS_ORIGINS=

# Rate limiting (per client IP)
# INTERVAL_SECS: Seconds until one used request is restored
# BURST_SIZE: requests allowed back-to-back before throttling.
LOGIN__INTERVAL_SECS=10
LOGIN__BURST_SIZE=5
REGISTER__INTERVAL_SECS=60
REGISTER__BURST_SIZE=3

# Logging (tracing_subscriber EnvFilter syntax)
RUST_LOG=info,zeitzeit=debug
