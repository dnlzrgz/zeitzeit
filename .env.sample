# Postgres (local dev container, see compose.yml)
POSTGRES_DB=zeitzeit
POSTGRES_USER=zeitzeit
POSTGRES_PASSWORD=zeitzeit_dev
POSTGRES_PORT=5433

# Database URL (read by sqlx-cli and by the API)
DATABASE_URL=postgres://zeitzeit:zeitzeit_dev@localhost:5433/zeitzeit
# Same database, addressed from inside the dev container (`db` is the compose service)
DEV_DATABASE_URL=postgres://zeitzeit:zeitzeit_dev@db:5432/zeitzeit

# API (names map to the `Config` fields: bind_addr, session_ttl_hours; DATABASE_URL stays bare)
BIND_ADDR=127.0.0.1:8080
# Host port published when the API runs in a container (native runs use BIND_ADDR)
API_PORT=8080
# Lifetime of a web session token. API tokens never expire by default.
SESSION_TTL_HOURS=720
# Browser origins allowed through CORS. Empty until a web client exists.
CORS_ORIGINS=

# Logging (tracing_subscriber EnvFilter syntax)
RUST_LOG=info,zeitzeit=debug
