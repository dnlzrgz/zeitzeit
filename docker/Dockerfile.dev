FROM rust:1.99.1-bookworm

RUN cargo install cargo-watch --locked

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
RUN mkdir src \
    && printf 'fn main() {}\n' > src/main.rs \
    && : > src/lib.rs \
    && cargo build --locked

ENV BIND_ADDR=0.0.0.0:8080
ENV RUST_LOG=info

EXPOSE 8080

CMD ["cargo", "watch", "--why", "-x", "run --locked --bin zeitzeit"]
